# Copiá este archivo a .env y completá con los datos de tu proyecto de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > SDK config)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL de Realtime Database (Firebase Console > Realtime Database > arriba de todo,
# algo como https://tu-proyecto-default-rtdb.firebaseio.com o .../southamerica-east1...)
VITE_FIREBASE_DATABASE_URL=

# (Opcional) Carga por voz con IA: URL "Production" del Webhook del workflow n8n/carga-por-voz.json
# Si lo dejás vacío, la carga por voz funciona igual con un intérprete básico sin IA.
VITE_VOZ_WEBHOOK_URL=
